# Copy to .env (used by docker compose AND by `npm run dev` locally).
# On Unraid, place this file next to docker-compose.yml.

# ---- Postgres (used by the postgres service + app DATABASE_URL) ----
POSTGRES_USER=breakfix
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=breakfix

# ---- Only needed if you run `npm run dev` outside of docker compose ----
# Inside the compose network, the app builds this URL automatically.
DATABASE_URL="postgresql://breakfix:change-me-strong-password@localhost:5432/breakfix?schema=public"

# ---- NextAuth ----
# NEXTAUTH_URL must be the URL a browser uses to reach the app.
# On Unraid, that is typically http://<tower-ip>:3000 while you test.
NEXTAUTH_URL="http://localhost:3000"
# Generate a real secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# ---- Host port the app is published on ----
APP_PORT=3000

# ---- Bootstrap: the first ADMIN user that is created on a fresh DB ----
BOOTSTRAP_ADMIN_EMAIL="admin@breakfix.local"
BOOTSTRAP_ADMIN_PASSWORD="replace-me"
BOOTSTRAP_ADMIN_NAME="Ops Admin"

# ---- Optional: Google Workspace SSO (leave blank for credentials-only) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAINS=""

# ---- Route optimizer selection ----
# Supported values: nearest-neighbor (default, built-in) | google-routes
ROUTE_OPTIMIZER="nearest-neighbor"
# Required if ROUTE_OPTIMIZER=google-routes. Create a Google Cloud project,
# enable the Routes API, and provision a key scoped to that API.
GOOGLE_ROUTES_API_KEY=""

# ---- Notification transport (Phase 4) ----
# "stdout" (default) logs every notification to the container log.
# "smtp" sends real email via the SMTP_* settings below.
NOTIFICATION_TRANSPORT="stdout"

# ---- SMTP settings (only needed if NOTIFICATION_TRANSPORT=smtp) ----
# Google Workspace relay example:
#   SMTP_HOST=smtp-relay.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false   (STARTTLS on 587)
#   SMTP_USER=<service account in workspace>
#   SMTP_PASS=<app password>
#   SMTP_FROM="BreakFix Triage <ops@nyc.gov>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_REPLY_TO=""

# ---- Cutover kill switch (Phase 5) ----
# Set to "true" to reject all non-GET requests at the edge. A banner
# appears on every page while this is active. Use it during the
# cutover weekend so staff can still read the app while you run the
# final export/integrity/compare cycle without any races.
READ_ONLY_MODE="false"

# ---- ServiceNow API connector (Phase 4) ----
# Leave SERVICENOW_BASE_URL blank to disable the API mode; file uploads
# still work via the /imports/new page.
SERVICENOW_BASE_URL=""
SERVICENOW_USERNAME=""
SERVICENOW_PASSWORD=""
# Optional: override the filter passed to the incident table. Default
# is "active=true^ORDERBYDESCopened_at".
SERVICENOW_QUERY=""
# Optional: page size (default 200).
SERVICENOW_LIMIT=""
# Optional: email of the user whose id gets stamped on batches created
# by the cron script. Defaults to the first active ADMIN.
SERVICENOW_SYNC_USER_EMAIL=""
