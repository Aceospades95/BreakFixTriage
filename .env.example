# Copy to .env.local and fill in.

# Database
DATABASE_URL="postgresql://breakfix:breakfix@localhost:5432/breakfix?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-32-byte-random-string"

# Optional: Google Workspace SSO (leave blank to use credentials-only login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAINS=""

# Optional: route optimizer selection
ROUTE_OPTIMIZER="nearest-neighbor"   # or "google-routes"
GOOGLE_ROUTES_API_KEY=""

# Optional: notification transport
NOTIFICATION_TRANSPORT="stdout"      # or "smtp" | "gmail" | "apps-script"
