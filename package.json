{
  "name": "breakfix-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Break-fix operations platform for NYC DOE device repair lifecycle management.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:defaults": "tsx prisma/seed-defaults.ts",
    "db:seed:test": "tsx prisma/seed-test.ts",
    "db:reset": "prisma migrate reset --force",
    "quotes:sweep": "tsx prisma/sweep-quotes.ts",
    "quotes:repair-consumed": "tsx scripts/repair-consumed-quote-approvals.ts",
    "servicenow:sync": "tsx prisma/sync-servicenow.ts",
    "cutover:compare": "tsx prisma/cutover-compare.ts",
    "cutover:integrity": "tsx prisma/cutover-integrity.ts",
    "cutover:export": "tsx prisma/cutover-export.ts",
    "escalate:stale": "tsx prisma/escalate-stale.ts",
    "digest": "tsx prisma/send-digest.ts",
    "schools:fix-addresses": "tsx scripts/fix-school-addresses.ts",
    "email:worker": "tsx scripts/email-worker.ts",
    "email:seed-templates": "tsx prisma/seed-email-templates.ts",
    "reports:daily": "tsx scripts/send-scheduled-reports.ts --period=daily",
    "reports:weekly": "tsx scripts/send-scheduled-reports.ts --period=weekly",
    "reports:monthly": "tsx scripts/send-scheduled-reports.ts --period=monthly",
    "reports:site:weekly": "tsx scripts/send-site-summaries.ts --period=week",
    "reports:site:monthly": "tsx scripts/send-site-summaries.ts --period=month"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "next": "^14.2.15",
    "next-auth": "^4.24.10",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "papaparse": "^5.4.1",
    "pg-boss": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "1.56.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^6.4.23",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
