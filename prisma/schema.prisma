// BreakFix Triage — Prisma schema
//
// This is the authoritative data model. Update this file and run
// `npm run db:migrate` to evolve the database. See docs/DOMAIN.md for the
// business meaning of each entity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & organization
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  OPS_MANAGER
  DISPATCHER
  WAREHOUSE
  TECHNICIAN
  DRIVER
  READ_ONLY
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  passwordHash         String?
  role                 Role           @default(READ_ONLY)
  active               Boolean        @default(true)
  /// Phase 11: TOTP 2FA. When totpEnabledAt is set, the credentials
  /// provider requires a valid six-digit code (or a one-use recovery
  /// code). Admins can reset by blanking both columns.
  totpSecret           String?
  totpEnabledAt        DateTime?
  /// JSON array of hashed one-time recovery codes. When a code is
  /// used successfully it is removed from the array.
  backupCodes          String?
  /// JWTs issued before this timestamp are rejected. Bumped to now()
  /// when an admin signs out all sessions OR resets a user's 2FA.
  /// Coarse-grained (kills every session at once); pair with the
  /// per-row UserSession.revokedAt for individual sign-outs. ADR 0015.
  sessionRevokedBefore DateTime?
  /// Per-user key/value state owned by the app — onboarding flags,
  /// UI preferences, dismissed banners. JSON blob so we don't need a
  /// migration for every new key.
  meta                 Json?
  // Districts this user is allowed to operate in. Admins typically have all.
  districts            DistrictUser[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Inverse relations
  ticketEventsActed   TicketEvent[]       @relation("TicketEventActor")
  importBatches       ImportBatch[]
  resolvedDupes       DuplicateConflict[] @relation("DupeResolver")
  auditLogs           AuditLog[]          @relation("AuditActor")
  acknowledgedAudits  AuditLog[]          @relation("AuditAcknowledger")
  assignedTickets     Ticket[]            @relation("TicketAssignee")
  assignedRoutes      Route[]             @relation("RouteAssignee")
  quoteActivities     QuoteActivity[]
  comments            Comment[]           @relation("CommentAuthor")
  uploadedAttachments Attachment[]        @relation("AttachmentUploader")
  inAppNotifications  InAppNotification[] @relation("InAppNotificationRecipient")
  partMovements       PartMovement[]      @relation("PartMovementUser")
  timeEntries         TimeEntry[]         @relation("UserTimeEntries")
  /// Round-10 §1F — sign-in sessions tracked for the
  /// /admin/users/[id] Recent sessions panel + Sign out all
  /// sessions affordance.
  sessions            UserSession[]       @relation("UserSessionsOwner")
  // Round-20 — NY team batch.
  teamNotes           TeamNote[]          @relation("TeamNoteAuthor")
  teamNoteAcks        TeamNoteAck[]       @relation("TeamNoteAckUser")
  expenses            Expense[]           @relation("ExpenseSubmitter")
  reviewedExpenses    Expense[]           @relation("ExpenseReviewer")

  @@index([role])
}

// Round-10 §1F — UserSession.
//
// One row per authenticated browser. Created on sign-in by the
// NextAuth events hook in lib/auth/auth.ts; lastSeenAt bumps on
// each authenticated request via middleware. Admins revoke every
// active row for a user with the "Sign out all sessions" button on
// /admin/users/[id]; the corresponding audit row is
// action=user.sessions_revoked.
//
// IP + userAgent fingerprints capture enough to spot anomalies
// (different city, fresh device) without storing raw cookies.
// revokedAt is set when the admin button fires OR when the user
// signs out; null = active.
model UserSession {
  id            String    @id @default(cuid())
  userId        String
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  // Round-11 §1C — store hashed forensics, never raw IP / UA. The
  // hash is salted with AUTH_SESSION_SALT so an offline attacker
  // who steals a copy of the table can't reverse the IP space.
  ipHash        String?
  uaFingerprint String?
  // Round-11 §1C — explicit expiry mirrors the NextAuth maxAge
  // (12h) so the panel can label rows past their expiry as
  // "expired" without comparing against the JWT.
  expiresAt     DateTime?
  revokedAt     DateTime?

  user User @relation("UserSessionsOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

model District {
  id         String         @id @default(cuid())
  name       String
  code       String         @unique
  region     String?
  active     Boolean        @default(true)
  /// Round-3 §H22: soft-disable timestamp. Preferred over delete
  /// when schools are attached. The list page shows disabled
  /// districts greyed-out with a "Re-enable" action.
  disabledAt DateTime?
  schools    School[]
  users      DistrictUser[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model DistrictUser {
  districtId String
  userId     String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([districtId, userId])
}

model Address {
  id         String   @id @default(cuid())
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  latitude   Float?
  longitude  Float?
  schools    School[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model School {
  id            String  @id @default(cuid())
  districtId    String
  name          String
  code          String? @unique // NYC DBN (e.g., 11X123)
  addressId     String?
  mainContactId String? @unique
  notes         String?
  active        Boolean @default(true)
  /// Round-2 §7/§9: flagged true when the school's address looks
  /// placeholder-ish (legacy "11X101 Address Line" or null lat/lng).
  /// Set by scripts/fix-school-addresses.ts and toggled to false on a
  /// successful geocode.
  needsAddress  Boolean @default(false)

  district    District @relation(fields: [districtId], references: [id])
  address     Address? @relation(fields: [addressId], references: [id])
  mainContact Contact? @relation("SchoolMainContact", fields: [mainContactId], references: [id])

  contacts     Contact[]     @relation("SchoolContacts")
  devices      Device[]
  tickets      Ticket[]
  jobs         Job[]
  portalTokens PortalToken[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expenses     Expense[]

  @@index([districtId])
}

model Contact {
  id                       String   @id @default(cuid())
  schoolId                 String
  name                     String
  title                    String?
  email                    String?
  phone                    String?
  isPrimary                Boolean  @default(false)
  /// Round-2 §2/§7: per-contact email opt-ins. SPOC = School
  /// Point Of Contact. Each flag gates whether this contact is
  /// included by `kind: 'spoc'` recipient resolution for the
  /// matching event family. Default false to keep existing
  /// contacts opted-out until ops explicitly enables them.
  receivesTicketEmails     Boolean  @default(false)
  receivesQuoteEmails      Boolean  @default(false)
  receivesDeliveryReceipts Boolean  @default(false)
  ccOnAllTickets           Boolean  @default(false)
  preferredLanguage        String   @default("en")
  school                   School   @relation("SchoolContacts", fields: [schoolId], references: [id], onDelete: Cascade)
  mainOf                   School?  @relation("SchoolMainContact")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

enum FormFactor {
  LAPTOP
  CHROMEBOOK
  DESKTOP
  TABLET
  PHONE
  PRINTER
  NETWORK
  OTHER
}

model DeviceModel {
  id             String     @id @default(cuid())
  manufacturer   String
  modelName      String
  formFactor     FormFactor @default(OTHER)
  warrantyMonths Int?
  repairNotes    String?
  devices        Device[]
  parts          Part[]     @relation("PartCompatibility")

  @@unique([manufacturer, modelName])
}

model Device {
  id              String       @id @default(cuid())
  serialNumber    String       @unique
  assetTag        String?      @unique
  modelId         String?
  ownerSchoolId   String?
  purchaseDate    DateTime?
  warrantyExpires DateTime?
  notes           String?
  /// Round-3 §H20: optional MAC address for network-side diagnosis.
  macAddress      String?
  /// Round-3 §H20: free-form specs blob (RAM, OS version, screen size).
  specs           Json?
  /// Round-3 §H20: fallback for the Age column when purchaseDate is
  /// null. Set to `now()` on first import or first ticket.
  firstSeenAt     DateTime?
  /// Round-3 §H22: soft-retire timestamp. The list page hides
  /// retired devices behind a "Show retired" toggle.
  retiredAt       DateTime?
  retiredReason   String?
  model           DeviceModel? @relation(fields: [modelId], references: [id])
  school          School?      @relation(fields: [ownerSchoolId], references: [id])
  tickets         Ticket[]
  /// Round-4 §N1: every time this device appears on a route stop.
  stopDevices     StopDevice[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([ownerSchoolId])
  @@index([macAddress])
  @@index([retiredAt])
}

// ---------------------------------------------------------------------------
// Ticket lifecycle
// ---------------------------------------------------------------------------

enum TicketState {
  IMPORTED
  TRIAGE
  AWAITING_PICKUP
  PICKUP_SCHEDULED
  IN_WAREHOUSE
  DIAGNOSIS
  AWAITING_PARTS
  PARTS_ORDERED
  IN_REPAIR
  REPAIR_COMPLETED
  AWAITING_ONSITE
  ONSITE_IN_PROGRESS
  QUOTE_REQUIRED
  QUOTE_SENT
  QUOTE_APPROVED
  QUOTE_DECLINED
  QUOTE_NO_RESPONSE
  MANUFACTURER_RMA
  OUT_OF_SCOPE
  PENDING_DELIVERY
  DELIVERY_SCHEDULED
  RETURNED
  INVOICE_REQUIRED
  CLOSED
  REOPENED
  ON_HOLD
  /// Round-4 §N1: a synthetic ticket created when a tech adds a
  /// device to a route stop on the road — there's no SNOW
  /// counterpart yet. The ticket sits here until either:
  ///   - an SNOW import lands a matching `(serial, schoolId)`,
  ///     in which case `lib/snow-merge.ts` proposes a merge
  ///     in /duplicates (operator accepts → §D merge runs); OR
  ///   - the operator manually moves it to TRIAGE / IN_WAREHOUSE
  ///     / OUT_OF_SCOPE / CLOSED.
  /// Allowed transitions out: TRIAGE | IN_WAREHOUSE | OUT_OF_SCOPE
  /// | CLOSED. See `src/lib/workflow/states.ts`.
  PENDING_PICKUP_UNLINKED
}

/// Round-4 §N1: provenance tag for new tickets. `meta.source`
/// (free-form) was the carry-over from Round-2; this enum
/// makes it queryable + filterable. `IMPORTED` covers both
/// the legacy CSV path and the `SNOW` API pull (the route is
/// what differentiates them; `meta.importBatchId` carries
/// that). `MANUAL` is the inline create-from-template path.
/// `PORTAL` is a school-portal-initiated ticket. `ROUTE_PICKUP`
/// is the §N1 synthetic path.
enum TicketSource {
  IMPORTED
  MANUAL
  PORTAL
  ROUTE_PICKUP
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id                 String         @id @default(cuid())
  incidentNumber     String         @unique
  serviceNowSysId    String?        @unique
  deviceId           String?
  schoolId           String
  reportedAt         DateTime
  shortDescription   String
  longDescription    String?
  priority           TicketPriority @default(NORMAL)
  state              TicketState    @default(IMPORTED)
  substate           String?
  assignedUserId     String?
  // Free-form metadata we don't want to flatten into columns yet
  meta               Json?
  invoiceRequired    Boolean        @default(false)
  closedAt           DateTime?
  stateEnteredAt     DateTime       @default(now())
  /// Round-4 §N1: provenance tag. Defaults to IMPORTED so
  /// existing tickets keep working; the import pipeline + the
  /// PORTAL flow + the §N1 add-device path all set this
  /// explicitly going forward.
  source             TicketSource   @default(IMPORTED)
  /// Round-3 §B / §I: SLA pause state. When `slaPausedAt` is non-null
  /// the SLA helpers treat the interval [slaPausedAt, now] as
  /// excluded from age. Resume sets slaPausedAt back to null and
  /// pushes the paused-duration back into stateEnteredAt so the
  /// badge shows the correct age. `slaPausedReason` is required
  /// at the action site; the column is nullable for legacy rows.
  slaPausedAt        DateTime?
  slaPausedReason    String?
  slaPausedByUserId  String?
  /// Round-3 §B5: SLA warning + breach idempotency stamps. The
  /// cron checks these before firing so a ticket only generates
  /// `sla_breach_warning` once per warning threshold and
  /// `sla_breached` once per breach threshold.
  slaWarningFiredAt  DateTime?
  slaBreachFiredAt   DateTime?
  /// Phase 10: soft ticket merge. When set, the UI shows a "merged
  /// into X" banner and redirects writers to the target, but history
  /// on both rows is preserved.
  mergedIntoTicketId String?
  /// Round-2 §10: capture timestamp + actor + reason on the merge so
  /// the source ticket's read-only banner can render
  /// "merged into X on Y by Z because R" without joining audit rows.
  /// `mergedAt` also gates the 24h un-merge window.
  mergedAt           DateTime?
  mergeReason        String?
  mergedByUserId     String?

  device     Device?  @relation(fields: [deviceId], references: [id])
  school     School   @relation(fields: [schoolId], references: [id])
  assignee   User?    @relation("TicketAssignee", fields: [assignedUserId], references: [id])
  mergedInto Ticket?  @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id])
  mergedFrom Ticket[] @relation("TicketMerge")

  events           TicketEvent[]
  quotes           Quote[]
  jobLinks         TicketJob[]
  duplicateLefts   DuplicateConflict[] @relation("DupeLeft")
  duplicateRights  DuplicateConflict[] @relation("DupeRight")
  importRows       ImportRow[]
  notifications    Notification[]
  comments         Comment[]
  attachments      Attachment[]
  partUsages       PartUsage[]         @relation("PartUsageTicket")
  partMovements    PartMovement[]      @relation("PartMovementTicket")
  manufacturerRmas ManufacturerRma[]
  timeEntries      TimeEntry[]         @relation("TicketTimeEntries")
  /// Round-4 §N1: every time this ticket was on a route stop.
  /// Synthetic PENDING_PICKUP_UNLINKED tickets always have at
  /// least one row here (the stop that birthed them).
  stopDevices      StopDevice[]
  emailLogs        EmailLog[]          @relation("EmailLogToTicket")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([state])
  @@index([schoolId])
  @@index([deviceId])
  @@index([assignedUserId])
  @@index([stateEnteredAt])
  @@index([mergedIntoTicketId])
}

model TicketEvent {
  id          String       @id @default(cuid())
  ticketId    String
  fromState   TicketState?
  toState     TicketState
  actorUserId String?
  reason      String?
  payload     Json?
  createdAt   DateTime     @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketEventActor", fields: [actorUserId], references: [id])

  @@index([ticketId])
  @@index([toState])
  /// Round-22 — /bench/history closure log + monthly leaderboard
  /// filter (toState, createdAt window); /profile my-stats filters
  /// (actorUserId, createdAt window). Without these, both pages
  /// walk every CLOSED event ever recorded on each view.
  @@index([toState, createdAt])
  @@index([actorUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Import pipeline
// ---------------------------------------------------------------------------

enum ImportSource {
  SN_CSV
  SN_XLSX
  MANUAL
}

enum ImportType {
  TICKETS
  SCHOOLS
  DEVICES
  USERS
  PARTS
  DEVICE_MODELS
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY
  COMMITTING
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  INVALID
  DUPLICATE
  READY
  CREATED
  UPDATED
  REJECTED
  SKIPPED
}

model ImportBatch {
  id               String       @id @default(cuid())
  filename         String
  uploadedByUserId String
  source           ImportSource
  type             ImportType   @default(TICKETS)
  status           ImportStatus @default(PENDING)
  stats            Json?
  error            String?

  uploadedBy User                @relation(fields: [uploadedByUserId], references: [id])
  rows       ImportRow[]
  conflicts  DuplicateConflict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ImportRow {
  id                String          @id @default(cuid())
  batchId           String
  rowNumber         Int
  raw               Json
  normalized        Json?
  status            ImportRowStatus @default(PENDING)
  errors            String[]        @default([])
  resultingTicketId String?

  batch           ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resultingTicket Ticket?     @relation(fields: [resultingTicketId], references: [id])

  @@index([batchId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Duplicate handling
// ---------------------------------------------------------------------------

enum DuplicateKind {
  INCIDENT
  SERIAL
}

enum DuplicateResolution {
  MERGE_INTO_LEFT
  MERGE_INTO_RIGHT
  TREAT_AS_REOPEN
  KEEP_BOTH
  REJECT_NEW
}

model DuplicateConflict {
  id               String               @id @default(cuid())
  batchId          String?
  kind             DuplicateKind
  leftTicketId     String
  rightTicketId    String
  notes            String?
  resolution       DuplicateResolution?
  resolvedByUserId String?
  resolvedAt       DateTime?

  batch       ImportBatch? @relation(fields: [batchId], references: [id])
  leftTicket  Ticket       @relation("DupeLeft", fields: [leftTicketId], references: [id])
  rightTicket Ticket       @relation("DupeRight", fields: [rightTicketId], references: [id])
  resolvedBy  User?        @relation("DupeResolver", fields: [resolvedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([resolvedAt])
}

// ---------------------------------------------------------------------------
// Scheduling & dispatch
// ---------------------------------------------------------------------------

enum JobType {
  PICKUP
  DELIVERY
  ONSITE_REPAIR
  OTHER
}

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  EN_ROUTE
  ARRIVED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  schoolId    String
  status      JobStatus @default(UNSCHEDULED)
  windowStart DateTime?
  windowEnd   DateTime?
  notes       String?

  school      School      @relation(fields: [schoolId], references: [id])
  ticketLinks TicketJob[]
  routeStops  RouteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([schoolId])
}

// Join table so a job can cover multiple tickets (e.g. pickup of 6 devices)
// and a ticket may be associated with multiple jobs over its lifetime.
model TicketJob {
  ticketId String
  jobId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([ticketId, jobId])
}

enum RouteStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Route {
  id             String      @id @default(cuid())
  date           DateTime    @db.Date
  assigneeUserId String
  vehicleRef     String?
  status         RouteStatus @default(DRAFT)
  optimizerName  String?
  optimizedAt    DateTime?

  assignee User        @relation("RouteAssignee", fields: [assigneeUserId], references: [id])
  stops    RouteStop[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([date])
  @@index([assigneeUserId, date])
}

model RouteStop {
  id              String    @id @default(cuid())
  routeId         String
  jobId           String
  sequence        Int
  arrivalEstimate DateTime?
  status          JobStatus @default(SCHEDULED)

  /// Round-4 §C + §N2: live position when the tech taps "Arrived"
  /// in the field. Used by the §C print sheet snapshot, the §N2
  /// /scheduling/people live-position pin tooltip, and the
  /// /admin/audit chip on the route detail page. Nullable so
  /// historical stops without a captured position keep working.
  arrivedLat Float?
  arrivedLng Float?
  arrivedAt  DateTime?

  /// Round-20 — NY team: "mark if the delivery or pick up will be
  /// delayed due to unexpected circumstances". Setting a delay
  /// pushes arrivalEstimate by delayMinutes, surfaces an amber chip
  /// on the route + schedule, and emails the SPOC of every ticket
  /// on the stop (stop_delayed event).
  delayReason  StopDelayReason?
  delayMinutes Int?
  delayNote    String?
  delayedAt    DateTime?

  /// Round-21 — why the stop FAILED ("Device not found — reschedule
  /// required", "School closed", …). Stamped by updateStopStatus
  /// from the driver's reason picker so dispatch can triage
  /// reschedules from the stop card instead of the audit log.
  failureReason String?

  /// Round-22 §1C — free-text stop notes the technician records on
  /// site. The "Other — see stop notes" fail reason references this
  /// field, which previously did not exist.
  notes String?

  /// Round-22 §1D — proof the stop requires before completion. Set
  /// per job type at build time (deliveries need a signature; pickups
  /// a photo); enforced by the completion gate.
  proofRule ProofRule @default(PHOTO_AND_SIGNATURE)

  /// Round-22 §1D — when a stop is completed without satisfying its
  /// proof rule, the technician must supply an override reason. It is
  /// stamped here (flagged on the record) and written as a
  /// high-visibility audit line.
  proofOverrideReason   String?
  proofOverrideByUserId String?
  proofOverrideAt       DateTime?

  route       Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id])
  attachments Attachment[]
  /// Round-4 §N1: device lines on this stop. Each StopDevice
  /// optionally references a Ticket — a placeholder add (kind
  /// "placeholder") creates the synthetic ticket in
  /// PENDING_PICKUP_UNLINKED; an existing-device add either
  /// links to its open ticket at the same school, or creates
  /// a synthetic if no such ticket exists.
  stopDevices StopDevice[]

  @@index([routeId])
  @@index([jobId])
  @@index([arrivedAt])
}

// ---------------------------------------------------------------------------
// Round-4 §N1: route stop ↔ device join
// ---------------------------------------------------------------------------
//
// Captures every device picked up or dropped off at a stop, with a
// lifecycle of its own (added when the tech taps "+ Add device" on
// the stop card; removed when "× Remove" is tapped — the device row
// stays for audit, with `removedAt` set).
//
// `ticketId` is nullable for the rare race where a placeholder
// device is added but the synthetic-ticket creation fails; the row
// is reachable via `addedBy` + `addedAt` so the operator can resolve
// the orphan from the duplicate queue.

model StopDevice {
  id                String            @id @default(cuid())
  stopId            String
  /// Nullable since Round-22 §1C: a stop line is now pre-populated
  /// from each expected ticket at build time, and a pickup ticket
  /// often has no device linked yet (the device is collected on the
  /// visit). Such a line carries the ticket with deviceId null until
  /// the technician records the physical device on site.
  deviceId          String?
  /// Open ticket attached to the (device, stop). Set on creation.
  /// Null is valid only for transient orphans (resolve via
  /// /duplicates).
  ticketId          String?
  /// Round-22 §1C — per-line verification state. See StopLineState.
  /// Pre-populated lines start EXPECTED; the technician resolves each
  /// on site. Ad-hoc on-site adds are born EXTRA_ADDED.
  lineState         StopLineState     @default(EXPECTED)
  /// Round-22 §1C — optional per-line note (e.g. why NOT_FOUND).
  lineNote          String?
  /// Whether this device is being PICKED UP from the school or
  /// DELIVERED to it. Defaults to the parent Job.type when not
  /// supplied — usually the same intent — but can be overridden
  /// when a delivery stop discovers a device that needs pickup
  /// (or vice versa). Operators set this from the +Add device
  /// form on /scheduling/routes/[routeId].
  purpose           StopDevicePurpose @default(PICKUP)
  addedAt           DateTime          @default(now())
  addedByUserId     String
  /// Set when the operator taps "× Remove". The device row stays
  /// for audit; the ticket itself stays open (the brief is
  /// explicit: removing a device from a stop does NOT close its
  /// ticket).
  removedAt         DateTime?
  removedByUserId   String?
  /// Required when removing — operator must explain why the device
  /// is coming off the stop (loaded wrong device, school doesn't
  /// have it, customer cancelled, etc.). Min 3 chars enforced at
  /// the action layer.
  removedReason     String?
  /// Round-20 — NY team: "we should have to select what we are
  /// picking up". Stamped by updateStopStatusAction when the tech
  /// confirms this exact device line while completing the stop;
  /// the server refuses to complete a stop whose active lines are
  /// not all confirmed. Durable record of the field check-off.
  confirmedAt       DateTime?
  confirmedByUserId String?

  stop   RouteStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  device Device?   @relation(fields: [deviceId], references: [id])
  ticket Ticket?   @relation(fields: [ticketId], references: [id])

  @@index([stopId])
  @@index([deviceId])
  @@index([ticketId])
  @@index([removedAt])
  @@index([purpose])
  @@index([lineState])
}

/// Round-13 — pickup vs delivery for an individual StopDevice line.
/// Mirrors the JobType enum (PICKUP/DELIVERY) so a stop can mix
/// both intents on the same visit if a missed pickup is discovered
/// during a delivery (or vice versa).
enum StopDevicePurpose {
  PICKUP
  DELIVERY
}

/// Round-22 §1C — per-line verification state for a stop line item.
/// A line is born EXPECTED (pre-populated from the job's tickets at
/// build time). On site the technician resolves each one:
///   VERIFIED      — handed over / collected as expected (success)
///   NOT_FOUND     — the device wasn't there to pick up / deliver
///   REFUSED       — the school declined to accept / release it
///   EXTRA_ADDED   — discovered on site, not on the original manifest
/// "Resolved" = anything other than EXPECTED. The completion gate
/// requires every active line resolved; PARTIAL emerges when the
/// resolutions are mixed (some VERIFIED, some NOT_FOUND/REFUSED).
enum StopLineState {
  EXPECTED
  VERIFIED
  NOT_FOUND
  REFUSED
  EXTRA_ADDED
}

/// Round-22 §1D — what proof a stop requires before it can be
/// completed. Enforced by the completion gate (not just displayed).
/// An explicit override with a reason is the only way past an unmet
/// rule, and the override is flagged on the record + audited.
enum ProofRule {
  NONE
  PHOTO
  SIGNATURE
  PHOTO_AND_SIGNATURE
}

/// Round-20 — why a pickup/delivery is running late. NY team's
/// list verbatim plus OTHER for the long tail.
enum StopDelayReason {
  CONSTRUCTION
  WEATHER
  VEHICLE_EMERGENCY
  PREVIOUS_STOP_DELAY
  OTHER
}

// ---------------------------------------------------------------------------
// Commercial (quotes / POs)
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  NO_RESPONSE
  CANCELLED
}

model Quote {
  id             String      @id @default(cuid())
  ticketId       String
  status         QuoteStatus @default(DRAFT)
  amountCents    Int?
  diagnosticOnly Boolean     @default(false)
  holdUntil      DateTime?
  sentAt         DateTime?
  respondedAt    DateTime?
  notes          String?

  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  activities    QuoteActivity[]
  purchaseOrder PurchaseOrder?
  attachments   Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([status])
}

model QuoteActivity {
  id          String   @id @default(cuid())
  quoteId     String
  kind        String
  actorUserId String?
  payload     Json?
  createdAt   DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([quoteId])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  quoteId         String    @unique
  poNumber        String    @unique
  issuedAt        DateTime
  amountCents     Int
  invoiceRequired Boolean   @default(false)
  invoicedAt      DateTime?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Ops: audit + notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  before         Json?
  after          Json?
  /// Round-13 §1J — promoted from JSON-buried before/after. Free-text
  /// rationale supplied by the actor (e.g. "Customer escalation").
  reason         String?
  /// Round-13 §1J — transition kind for force/manual/kanban/scheduled
  /// /webhook/system_seed/bulk/import. Filterable on /admin/audit.
  transitionType String?
  /// Round-13 §1J — request ID groups rows produced within one
  /// inbound HTTP request. Bulk actions write N rows + 1 summary
  /// sharing the same requestId.
  requestId      String?
  /// Round-13 §1J — severity tier: info | warn | critical. Force
  /// changes write `warn`; tenant-violation rejections write
  /// `critical`. Default keeps every prior write classified `info`.
  severity       String?  @default("info")
  /// Round-22 §2 — a high-severity event can be acknowledged so it
  /// leaves the active exceptions count + badge instead of squatting
  /// there for a rolling 7 days. Null = still needs attention.
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  createdAt      DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])
  acknowledgedBy User? @relation("AuditAcknowledger", fields: [acknowledgedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([transitionType])
  @@index([severity])
  @@index([requestId])
  @@index([severity, acknowledgedAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationKind {
  DEVICE_SCHEDULED
  PICKUP_SCHEDULED
  DELIVERY_SCHEDULED
  QUOTE_SENT
  QUOTE_FOLLOW_UP
  OUT_OF_SCOPE_CLOSURE
  NO_RESPONSE_CLOSURE
  GENERIC
}

model Notification {
  id             String             @id @default(cuid())
  kind           NotificationKind
  ticketId       String?
  quoteId        String?
  recipientEmail String
  subject        String
  body           String
  status         NotificationStatus @default(PENDING)
  transport      String
  sentAt         DateTime?
  error          String?

  ticket Ticket? @relation(fields: [ticketId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Collaboration: comments & attachments (Phase 6)
// ---------------------------------------------------------------------------

/// A free-text comment on a ticket. Used by ops, techs, and drivers to
/// talk to each other about a specific ticket without leaving the app.
/// Editing is intentionally limited (no rich text, no @mentions yet) —
/// the point is to capture context that lives with the ticket instead
/// of in Slack DMs.
model Comment {
  id           String    @id @default(cuid())
  ticketId     String
  authorUserId String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  editedAt     DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("CommentAuthor", fields: [authorUserId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

enum AttachmentKind {
  TICKET
  ROUTE_STOP
  QUOTE
  EXPENSE
}

/// Binary blobs uploaded by users. Stored on the app's local volume
/// (ATTACHMENTS_DIR) with a sanitized filename, referenced here by
/// relative path. Polymorphic: exactly one of ticketId / routeStopId
/// / quoteId is set, chosen by the `kind` discriminator.
model Attachment {
  id               String         @id @default(cuid())
  kind             AttachmentKind
  ticketId         String?
  routeStopId      String?
  quoteId          String?
  expenseId        String?
  uploadedByUserId String
  filename         String
  storedPath       String
  mimeType         String
  sizeBytes        Int
  /// Printed name of the person who signed, for signature
  /// attachments captured via the SignaturePad ("who signed for
  /// this pickup/delivery"). Null for ordinary file uploads.
  signerName       String?
  /// Optional free-text context captured with the proof ("left with
  /// front desk", "custodian signed, AP unavailable", …).
  note             String?
  createdAt        DateTime       @default(now())

  ticket     Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  routeStop  RouteStop? @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  quote      Quote?     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  expense    Expense?   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id])

  @@index([ticketId])
  @@index([routeStopId])
  @@index([quoteId])
  @@index([expenseId])
}

// ---------------------------------------------------------------------------
// In-app notifications (Phase 7)
// ---------------------------------------------------------------------------

enum InAppNotificationKind {
  TICKET_ASSIGNED
  TICKET_MENTION
  /// Round-22 (demo): someone other than the assignee moved the
  /// ticket — "whoever updates it, I automatically get it".
  TICKET_UPDATED
  SLA_BREACH
  ESCALATION
  GENERIC
}

/// Lightweight notifications shown in the header bell dropdown. Kept
/// separate from the email-oriented Notification model because they
/// have very different concerns (no delivery status, no transport, no
/// bounce tracking — just "unread until you click it").
model InAppNotification {
  id              String                @id @default(cuid())
  recipientUserId String
  kind            InAppNotificationKind
  title           String
  body            String?
  linkHref        String?
  /// Round-3 §A4 / §15: optional entity links so the bell popover
  /// can deep-link to the right ticket/route/quote without
  /// reverse-parsing linkHref. Nullable so existing rows still
  /// work — the bell falls back to linkHref when these are unset.
  ticketId        String?
  routeId         String?
  quoteId         String?
  readAt          DateTime?
  createdAt       DateTime              @default(now())

  recipient User @relation("InAppNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([createdAt])
  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// App-wide settings (Phase 7)
// ---------------------------------------------------------------------------

/// Key/value store for settings an admin should be able to edit without
/// a redeploy. Values are JSON-encoded strings so we can store numbers,
/// arrays, and objects without committing to a column type. The
/// `lib/settings` helpers parse + validate on read.
model AppSetting {
  key             String   @id
  value           String
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

// ---------------------------------------------------------------------------
// Parts inventory (Phase 8)
// ---------------------------------------------------------------------------

/// A physical spare part the warehouse keeps in stock. Parts are
/// consumed by repairs (recorded as PartUsage + a CONSUMED movement),
/// received from suppliers (RECEIVED), and periodically reconciled
/// (ADJUSTMENT).
///
/// The `onHand` column is a denormalized running total. Every service
/// that touches a Part MUST go through the `applyPartMovement` helper
/// so the running total stays in sync with the movement log — direct
/// writes are a footgun.
model Part {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  description  String?
  onHand       Int      @default(0)
  reorderLevel Int      @default(0)
  costCents    Int?
  location     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  compatibleModels DeviceModel[]  @relation("PartCompatibility")
  movements        PartMovement[]
  usages           PartUsage[]

  @@index([active])
  @@index([name])
}

enum PartMovementKind {
  RECEIVED
  CONSUMED
  ADJUSTMENT
  RETURNED
  SCRAPPED
}

/// Append-only log of every stock change. The delta is signed so a
/// CONSUMED movement stores `quantity = -N`. Summing all deltas for a
/// part should always equal `Part.onHand`.
model PartMovement {
  id        String           @id @default(cuid())
  partId    String
  kind      PartMovementKind
  quantity  Int
  ticketId  String?
  userId    String?
  reason    String?
  createdAt DateTime         @default(now())

  part   Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation("PartMovementTicket", fields: [ticketId], references: [id])
  user   User?   @relation("PartMovementUser", fields: [userId], references: [id])

  @@index([partId])
  @@index([ticketId])
  @@index([createdAt])
}

/// Convenience join: which parts were used on which ticket. Derived
/// from the movement log but materialized so the ticket detail page
/// can render a parts list in O(1) queries. Kept in sync by
/// `recordPartUsage` alongside a CONSUMED movement.
model PartUsage {
  id        String   @id @default(cuid())
  ticketId  String
  partId    String
  quantity  Int
  createdAt DateTime @default(now())

  ticket Ticket @relation("PartUsageTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  part   Part   @relation(fields: [partId], references: [id])

  @@index([ticketId])
  @@index([partId])
}

// ---------------------------------------------------------------------------
// Manufacturer RMA (Phase 8)
// ---------------------------------------------------------------------------

/// Out-of-warehouse repair tracking. When a device goes back to the
/// vendor for warranty repair (MANUFACTURER_RMA state), this row
/// records the paperwork: RMA number, vendor, shipping tracking both
/// ways, and dates.
model ManufacturerRma {
  id          String    @id @default(cuid())
  ticketId    String
  rmaNumber   String
  vendor      String
  shippedAt   DateTime?
  receivedAt  DateTime?
  trackingOut String?
  trackingIn  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([rmaNumber])
}

// ---------------------------------------------------------------------------
// School-facing status portal (Phase 8)
// ---------------------------------------------------------------------------

/// Magic-link token that grants a school contact read-only access to
/// their school's tickets without signing in. An admin generates a
/// token on the school profile page and shares the URL with the
/// school's IT lead; they bookmark it and use it to check status on
/// their own instead of emailing operations.
///
/// The token is a cryptographically random string stored in the
/// `token` column. Revocation is soft — we keep the row so we can
/// tell ops who was using which link and when.
model PortalToken {
  id          String    @id @default(cuid())
  /// Round-13 §1I — SHA-256 hash of the plaintext token. Plaintext
  /// is shown ONCE on creation and never stored. Legacy plaintext
  /// values are migrated by `prisma/migrations/...portal-token-hash`.
  token       String    @unique
  /// First eight characters of the plaintext (kept human-readable
  /// for the operator UI), e.g. "xY4kP2mN". Never sent in URLs.
  tokenPrefix String?
  /// Round-13 §2L — STANDARD shows serial/asset/desc on the portal
  /// page; MINIMAL hides them. Default STANDARD for backwards-compat
  /// with R12 token rows.
  dataScope   String    @default("STANDARD")
  schoolId    String
  label       String?
  /// Default 365 days from creation per ADR 0015 — populated by the
  /// generate helper when caller doesn't supply a TTL.
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Shift handover notes (Phase 8)
// ---------------------------------------------------------------------------
// Phase 10: ticket templates + time tracking
// ---------------------------------------------------------------------------

/// Preset shapes for common repair tickets. The quick-create form
/// on the ticket list lets ops spin up a new ticket with one click
/// instead of typing the same short description for the tenth time
/// this week ("cracked screen", "battery won't charge", etc.).
///
/// Kept deliberately simple: name, short description, long
/// description, priority. A real template system could grow fields
/// over time (state presets, auto-assignments), but this covers 90%
/// of the pain today.
model TicketTemplate {
  id               String         @id @default(cuid())
  name             String         @unique
  shortDescription String
  longDescription  String?
  priority         TicketPriority @default(NORMAL)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([active])
}

/// Time tracking on tickets. A tech starts a timer, works, stops it,
/// and the minutes are totaled per ticket and per user for the
/// productivity dashboard. The `startedAt` / `endedAt` pair keeps
/// the raw history; `minutes` is denormalized for fast aggregation.
///
/// Only one open (unclosed) timer per user at a time — enforced in
/// the service, not the schema, because a unique partial index
/// would need raw SQL.
model TimeEntry {
  id          String    @id @default(cuid())
  ticketId    String
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  minutes     Int?
  notes       String?
  /// Round-3 §I24: tags an entry created via the manual-time form
  /// (vs. the start/stop timer). Lets the productivity dashboard
  /// distinguish lived-time from back-filled time.
  manualEntry Boolean   @default(false)
  createdAt   DateTime  @default(now())

  ticket Ticket @relation("TicketTimeEntries", fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation("UserTimeEntries", fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId, endedAt])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Round-2: Email / notification rules domain
// ---------------------------------------------------------------------------
//
// New domain in pass 3 (round-2/email-rules-and-qa-pass). Replaces ad-hoc
// `Notification` writes (single-recipient, no html, no template trail) with
// a rules-engine: an EmailRule names recipients, links a template, and
// fires on a domain event. EmailLog records every send with full headers
// + status. EmailJob is the DB-backed queue; the worker (scripts/email-
// worker.ts) claims rows via SELECT FOR UPDATE SKIP LOCKED.
//
// The legacy `Notification` model stays for the lifecycle code paths that
// still write through it; the new entrypoint `dispatchEmailEvent` writes
// EmailLog instead. Migration plan in docs/adr/0007-email-rules-and-templates.md.

enum EmailRuleScope {
  GLOBAL
  DISTRICT
  SCHOOL
  TICKET
}

/// Domain events that an EmailRule can fire on. Matches the keys
/// pre-seeded into EmailTemplate. Adding a new event = (a) extend
/// this enum, (b) add a matching template seed, (c) wire a
/// dispatchEmailEvent call at the trigger site.
enum EmailEvent {
  ticket_created
  ticket_assigned
  ticket_status_changed
  quote_sent
  quote_approved_internal
  delivery_scheduled
  delivery_completed_with_receipt
  sla_breach_warning
  sla_breached
  daily_digest
  // Round-6 §3A — four highest-impact status-change events with
  // dedicated rules so admins can recipient-design per state. The
  // generic `ticket_status_changed` stays for catch-all rules.
  status_in_repair
  status_parts_ordered
  ticket_closed
  // Round-6 §3B — manual operator-to-SPOC ticket update.
  ticket_update_to_spoc
  // Round-7 §3B — quote approve (school user) + pickup complete.
  // `quote_sent` and `delivery_scheduled` already exist above.
  // `quote_approved_internal` stays for the existing internal-only
  // notify when an operator approves on the school's behalf.
  quote_approved
  pickup_completed
  // Round-20 — NY team batch.
  // pickup_scheduled mirrors delivery_scheduled: SPOC hears when a
  // pickup route covering their ticket is built.
  pickup_scheduled
  // stop_delayed: SPOC hears when their stop is marked delayed
  // (construction / weather / vehicle emergency / previous stop).
  stop_delayed
  // Round-22 — the SPOCs of LATER stops on the same route hear that
  // an earlier stop is running late, so their visit may slip too.
  stop_delayed_downstream
  // Scheduled operations + finance reports (daily/weekly/monthly —
  // period rides in the template variables; recipients per event
  // via the rules engine).
  report_operations
  report_finance
  // Round-22 §4 — per-site weekly/monthly status summary, dispatched
  // SCHOOL-scoped so each school's contacts (the external POC) get
  // their own site report. Generated by scripts/send-site-summaries.ts.
  report_site
}

enum EmailLogStatus {
  queued
  sent
  failed
  bounced
}

enum EmailJobStatus {
  pending
  running
  done
  failed
}

model EmailTemplate {
  id              String   @id @default(cuid())
  /// Stable lookup key. Matches the EmailEvent enum value for
  /// event-triggered templates; ad-hoc templates use freeform keys
  /// (e.g. "noreply.test_send").
  key             String   @unique
  subject         String
  bodyHtml        String
  bodyText        String
  /// Loose JSONSchema describing the variables the template
  /// expects. Read by lib/email/render.ts to validate payloads
  /// before render.
  variables       Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rules EmailRule[]
  logs  EmailLog[]

  @@index([key])
}

model EmailRule {
  id              String         @id @default(cuid())
  scope           EmailRuleScope
  /// Cuid of the District / School / Ticket the rule binds to.
  /// Null when scope = GLOBAL.
  scopeId         String?
  event           EmailEvent
  /// { to: Recipient[], cc: Recipient[], bcc: Recipient[] }
  /// where Recipient = { kind: 'spoc'|'ticket_reporter'|'wynndalco_team'|'literal', value?: string }
  recipients      Json
  templateId      String
  enabled         Boolean        @default(true)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  template EmailTemplate @relation(fields: [templateId], references: [id])
  logs     EmailLog[]

  @@index([scope, scopeId, event, enabled])
  @@index([event, enabled])
}

model EmailLog {
  id                String         @id @default(cuid())
  ruleId            String?
  templateId        String
  ticketId          String?
  routeId           String?
  quoteId           String?
  to                String[]
  cc                String[]       @default([])
  bcc               String[]       @default([])
  subject           String
  bodyHtml          String
  status            EmailLogStatus @default(queued)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())

  rule     EmailRule?    @relation(fields: [ruleId], references: [id])
  template EmailTemplate @relation(fields: [templateId], references: [id])
  // Round-12 §1B — relation needed so /admin/email-log links can
  // canonicalise to /tickets/<incidentNumber>.
  ticket   Ticket?       @relation("EmailLogToTicket", fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([routeId])
  @@index([quoteId])
  @@index([status])
  @@index([createdAt])
}

model EmailJob {
  id          String         @id @default(cuid())
  templateKey String
  payload     Json
  attempts    Int            @default(0)
  nextRunAt   DateTime       @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  status      EmailJobStatus @default(pending)
  lastError   String?
  /// Optional pointer to the EmailLog row created up-front by
  /// dispatchEmailEvent — when the worker sends, it updates that
  /// row's status + providerMessageId rather than creating a new
  /// log entry. Idempotent retries land on the same log row.
  emailLogId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, nextRunAt])
  @@index([lockedAt])
}

// ---------------------------------------------------------------------------
// Round-2: Holidays + business-hours SLA
// ---------------------------------------------------------------------------

enum HolidayScope {
  GLOBAL
  DISTRICT
}

/// A non-business day. SLA math (lib/reports/sla.ts) excludes
/// holidays in the relevant scope when business-hours mode is on.
model Holiday {
  id        String       @id @default(cuid())
  date      DateTime     @db.Date
  label     String
  scope     HolidayScope @default(GLOBAL)
  scopeId   String?
  createdAt DateTime     @default(now())

  @@index([date, scope, scopeId])
}

// ---------------------------------------------------------------------------
// Round-2: User preferences
// ---------------------------------------------------------------------------

model UserPreference {
  userId             String   @id
  theme              String   @default("system")
  inAppNotifications Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  digestOptIn        Boolean  @default(false)
  /// 0..23 hour-of-day in the user's timezone for the daily digest.
  /// Null = use the system default (currently 07:00).
  digestHour         Int?
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Round-3 §C: school-portal request log
// ---------------------------------------------------------------------------
//
// Captures every "Request update" or "Report new issue" action from
// the public portal. Each row already has a matching audit row
// (actor labelled `portal:<token-suffix>`); this is a domain-side
// log so the school-portal admin view can render "your last 5
// requests" without a join through audit.

enum PortalRequestKind {
  UPDATE_REQUEST
  NEW_ISSUE
}

model PortalRequest {
  id              String            @id @default(cuid())
  /// Set when kind=UPDATE_REQUEST and the request lands on an
  /// existing ticket. Null for NEW_ISSUE kinds (the resulting
  /// ticket is captured via PortalRequest.createdTicketId).
  ticketId        String?
  /// Set when kind=NEW_ISSUE and the action created a new ticket.
  createdTicketId String?
  schoolId        String
  kind            PortalRequestKind
  body            String
  contactEmail    String?
  /// The PortalToken row that was used. Lets ops trace a request
  /// back to whichever bookmark the school clicked from.
  portalTokenId   String?
  createdAt       DateTime          @default(now())

  @@index([schoolId, createdAt])
  @@index([ticketId])
  @@index([createdTicketId])
}

// ---------------------------------------------------------------------------
// Round-4 §N2: people scheduling
// ---------------------------------------------------------------------------
//
// One row per scheduled block per user per day. ON_ROUTE blocks are
// **derived** at read-time from `Route` rows whose `assigneeUserId`
// matches and whose `date` matches; they are NEVER persisted here
// (the brief is explicit about this). That means deriveOnRouteBlocks()
// is the single source-of-truth bridge.
//
// `routeId` is non-null only when `kind = ON_ROUTE`, and that case
// is reserved for downstream consumers that want to materialise a
// computed block — the actions below never write `kind = ON_ROUTE`
// rows.
//
// RBAC:
//   - ADMIN / OPS_MANAGER / DISPATCHER can write any user's schedule.
//   - A user can write only their own PTO / OOO / TRAINING via
//     /me/schedule.
//   - WAREHOUSE / MEETING blocks are Ops-only.

enum StaffScheduleKind {
  WAREHOUSE
  ON_ROUTE
  PTO
  TRAINING
  OUT_OF_OFFICE
  MEETING
}

model StaffSchedule {
  id              String            @id @default(cuid())
  userId          String
  date            DateTime          @db.Date
  /// Minutes since 00:00 in the user's timezone.
  /// Range checks: 0 <= startMinute < endMinute <= 24*60.
  startMinute     Int
  endMinute       Int
  kind            StaffScheduleKind
  note            String?
  /// Set only when `kind = ON_ROUTE` AND a downstream actor
  /// chose to materialise the block (rare). The default is to
  /// leave ON_ROUTE blocks unpersisted and derived.
  routeId         String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, date, startMinute])
  @@index([date])
  @@index([userId, date])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Round-20 — NY team batch: urgent team notes + tech expenses
// ---------------------------------------------------------------------------

/// "Add a banner for urgent team notes so that everyone sees them.
/// Offer a click sign off to record that the tech acknowledged it."
/// Active notes render as a sticky banner in the app chrome until
/// the signed-in user acknowledges; acks are durable rows so ops
/// can see exactly who has(n't) seen a note.
model TeamNote {
  id              String    @id @default(cuid())
  body            String
  active          Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  /// Optional auto-expiry; an expired note stops rendering even if
  /// still flagged active.
  expiresAt       DateTime?
  deactivatedAt   DateTime?

  createdBy User          @relation("TeamNoteAuthor", fields: [createdByUserId], references: [id])
  acks      TeamNoteAck[]

  @@index([active])
}

model TeamNoteAck {
  noteId         String
  userId         String
  acknowledgedAt DateTime @default(now())

  note TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User     @relation("TeamNoteAckUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
}

/// "Ability for tech to submit bus fare receipts and generate an
/// expense report based on the tickets/locations serviced." Techs
/// submit from /me/expenses (receipt photo attaches via the
/// EXPENSE attachment kind); ops review on /admin/expenses; the
/// weekly finance report compiles them per tech.
enum ExpenseKind {
  TRANSIT
  TOLL
  PARKING
  OTHER
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model Expense {
  id               String        @id @default(cuid())
  techUserId       String
  kind             ExpenseKind   @default(TRANSIT)
  status           ExpenseStatus @default(SUBMITTED)
  amountCents      Int
  incurredOn       DateTime      @db.Date
  description      String?
  /// Optional links back to the work that incurred the cost so the
  /// weekly report can show tickets/locations serviced.
  routeId          String?
  ticketId         String?
  schoolId         String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tech        User         @relation("ExpenseSubmitter", fields: [techUserId], references: [id])
  reviewedBy  User?        @relation("ExpenseReviewer", fields: [reviewedByUserId], references: [id])
  route       Route?       @relation(fields: [routeId], references: [id])
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  school      School?      @relation(fields: [schoolId], references: [id])
  attachments Attachment[]

  @@index([techUserId, incurredOn])
  @@index([status])
  @@index([incurredOn])
}
